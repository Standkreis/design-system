{
  "name": "standkreis-design-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build -w @standkreis/ui && concurrently -k \"npm:watch:*\"",
    "watch:types": "npm run watch:types -w @standkreis/ui",
    "watch:styles": "npm run watch:styles -w @standkreis/ui",
    "watch:docs": "npm run dev -w @standkreis/docs",
    "build": "npm run build -w @standkreis/ui && npm run build -w @standkreis/docs",
    "typecheck": "tsc -p packages/ui/tsconfig.json --emitDeclarationOnly && tsc -p apps/docs/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test && npm run test:package",
    "test:package": "node scripts/check-package.mjs",
    "ui:add": "node scripts/add-components.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "concurrently": "^9.0.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "^4.10.0",
    "shadcn": "4.21.0"
  }
}
